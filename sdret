n {
    background: linear-gradient(135deg, #ff6ec4, #b46ef0);
    color: #fff;
    box-shadow: 0 10px 30px rgba(255,110,196,.5);
    animation: breathe 2s ease-in-out infinite;
    transition: transform .15s ease;
  }
  @keyframes breathe {
    0%,100% { box-shadow: 0 10px 30px rgba(255,110,196,.5) }
    50% { box-shadow: 0 10px 50px rgba(255,110,196,.9) }
  }
  #yesBtn:active { transform: scale(.95); }

  #noBtn {
    background: rgba(255,255,255,.1);
    color: #ddd;
    border: 1px solid rgba(255,255,255,.25);
    transition: left .18s ease, top .18s ease, transform .18s ease;
  }

  .final {
    font-size: clamp(1.4rem, 6.5vw, 2.2rem);
    color: #fff;
    text-shadow: 0 0 30px rgba(255,110,196,.9);
    animation: fadeIn 1s ease;
  }
  .heart {
    font-size: 4rem;
    display: block;
    margin-bottom: 20px;
    animation: beat 1s ease-in-out infinite;
  }
  @keyframes beat {
    0%,100% { transform: scale(1) }
    15% { transform: scale(1.2) }
    30% { transform: scale(1) }
    45% { transform: scale(1.15) }
  }
</style>
</head>
<body>

<div class="stars"></div>
<div class="glow"></div>

<!-- Блок с именем -->
<div class="name-top">Софа</div>

<div class="card" id="card">
  <div class="title">Ты мне нравишься...
<span>Станешь моей первой девушкой?</span></div>
  <div class="buttons" id="buttons">
    <button id="yesBtn">Да 💖</button>
    <button id="noBtn">Нет</button>
  </div>
</div>

<script>
  const noBtn  = document.getElementById('noBtn');
  const yesBtn = document.getElementById('yesBtn');
  const card   = document.getElementById('card');

  let noMoved = false;

  function runAway(e) {
    if (e) { e.preventDefault(); e.stopPropagation(); }
    const r = noBtn.getBoundingClientRect();

    if (!noMoved) {
      noBtn.style.position = 'fixed';
      noBtn.style.left = r.left + 'px';
      noBtn.style.top  = r.top  + 'px';
      noBtn.style.zIndex = 999;
      noMoved = true;
      requestAnimationFrame(() => moveToRandom());
    } else {
      moveToRandom();
    }
  }

  function moveToRandom() {
    const r = noBtn.getBoundingClientRect();
    const pad = 16;
    const maxX = window.innerWidth  - r.width  - pad;
    const maxY = window.innerHeight - r.height - pad;

    let newX, newY, dist;
    let tries = 0;
    do {
      newX = pad + Math.random() * Math.max(1, maxX - pad);
      newY = pad + Math.random() * Math.max(1, maxY - pad);
      dist = Math.hypot(newX - r.left, newY - r.top);
      tries++;
    } while (dist < 200 && tries < 20);

    noBtn.style.left = newX + 'px';
    noBtn.style.top  = newY + 'px';
    noBtn.style.transform = `rotate(${(Math.random() - .5) * 25}deg) scale(${.75 + Math.random() * .25})`;
  }

  noBtn.addEventListener('touchstart', runAway, { passive: false });
  noBtn.addEventListener('click', (e) => { e.preventDefault(); runAway(e); });
  document.addEventListener('touchmove', (e) => {
    const t = e.touches[0];
    if (!t) return;
    const r = noBtn.getBoundingClientRect();
    const d = Math.hypot(t.clientX - (r.left + r.width/2), t.clientY - (r.top + r.height/2));
    if (d < 80) runAway(e);
  }, { passive: false });

  noBtn.addEventListener('mouseenter', runAway);
  noBtn.addEventListener('mouseover', runAway);
  document.addEventListener('mousemove', (e) => {
    const r = noBtn.getBoundingClientRect();
    const d = Math.hypot(e.clientX - (r.left + r.width/2), e.clientY - (r.top + r.height/2));
    if (d < 90) runAway(e);
  });

  yesBtn.addEventListener('click', () => {
    card.innerHTML = `
      <span class="heart">💖</span>
      <div class="final">Софа, я знал, что ты скажешь «Да»!
Ты самая лучшая 🥰</div>
    `;
  });
</script>

</body>
</html>
